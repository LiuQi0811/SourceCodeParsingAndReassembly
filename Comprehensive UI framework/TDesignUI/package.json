{
  "name": "tdesignui-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:vue": "npm run dev --workspace=@tdesignui/vue",
    "dev:react": "npm run dev --workspace=@tdesignui/react",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ls:vite": "npm ls vite --workspaces --depth 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
