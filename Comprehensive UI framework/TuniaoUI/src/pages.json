{
	// easycom：components 目录下 `组件名/组件名.vue` 会自动按需引入（本项目自研的 demo-block 就用这个机制）
	"easycom": {
		"autoscan": true,
		// 自定义规则：tnx-button → 组件库 button/src/button.vue，用于演示 custom easycom
		"custom": {
			// 小程序端必须靠 easycom 生成 usingComponents；只在 H5/App 里全局注册不会进小程序组件表
			// 带子组件后缀的组件，目录名只取前缀
			"^tn-avatar-group$": "@tuniao/tnui-vue3-uniapp/components/avatar/src/avatar-group.vue",
			"^tn-checkbox-group$": "@tuniao/tnui-vue3-uniapp/components/checkbox/src/checkbox-group.vue",
			"^tn-collapse-item$": "@tuniao/tnui-vue3-uniapp/components/collapse/src/collapse-item.vue",
			"^tn-form-item$": "@tuniao/tnui-vue3-uniapp/components/form/src/form-item.vue",
			"^tn-list-item$": "@tuniao/tnui-vue3-uniapp/components/list/src/list-item.vue",
			"^tn-radio-group$": "@tuniao/tnui-vue3-uniapp/components/radio/src/radio-group.vue",
			"^tn-steps-item$": "@tuniao/tnui-vue3-uniapp/components/steps/src/steps-item.vue",
			"^tn-subsection-item$": "@tuniao/tnui-vue3-uniapp/components/subsection/src/subsection-item.vue",
			"^tn-swipe-action-item$": "@tuniao/tnui-vue3-uniapp/components/swipe-action/src/swipe-action-item.vue",
			"^tn-tabbar-item$": "@tuniao/tnui-vue3-uniapp/components/tabbar/src/tabbar-item.vue",
			"^tn-tabs-item$": "@tuniao/tnui-vue3-uniapp/components/tabs/src/tabs-item.vue",
			"^tn-(.*)": "@tuniao/tnui-vue3-uniapp/components/$1/src/$1.vue",
			// 自定义前缀示例：tnx-button → button 组件
			"^tnx-(.*)": "@tuniao/tnui-vue3-uniapp/components/$1/src/$1.vue"
		}
	},
	// 页面
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "TuniaoUI",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/components/index",
			"style": {
				"navigationBarTitleText": "组件总览",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/basic/index",
			"style": {
				"navigationBarTitleText": "基础组件"
			}
		},
		{
			"path": "pages/layout/index",
			"style": {
				"navigationBarTitleText": "布局与原子类"
			}
		},
		{
			"path": "pages/form/index",
			"style": {
				"navigationBarTitleText": "表单组件"
			}
		},
		{
			"path": "pages/feedback/index",
			"style": {
				"navigationBarTitleText": "反馈组件"
			}
		},
		{
			"path": "pages/nav/index",
			"style": {
				"navigationBarTitleText": "导航组件"
			}
		},
		{
			"path": "pages/data/index",
			"style": {
				"navigationBarTitleText": "数据展示"
			}
		},
		{
			"path": "pages/theme/index",
			"style": {
				"navigationBarTitleText": "主题 · 图标 · 多语言",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/template/index",
			"style": {
				"navigationBarTitleText": "实战模板",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/detail/index",
			"style": {
				"navigationBarTitleText": "商品详情",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/mine/index",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom"
			}
		},
		{
			// 进阶 API：类型化实例、validateField、beforeBack / beforeSwitch、事件全集、组件文案 i18n
			"path": "pages/advanced/index",
			"style": {
				"navigationBarTitleText": "进阶 API 与类型"
			}
		},
		{
			// 跨端：生命周期、网络 / 窗口监听、分享、媒体、扫码、定位、设置、拨号、能力探测
			"path": "pages/cross-platform/index",
			"style": {
				"navigationBarTitleText": "跨端与系统 API"
			}
		},
		{
			// 业务闭环：Pinia / 请求封装 / 登录态 / 购物车 / 订单分页
			"path": "pages/business/index",
			"style": {
				"navigationBarTitleText": "业务闭环",
				"enablePullDownRefresh": true,
				"onReachBottomDistance": 80,
				"backgroundColor": "#f4f7fb"
			}
		},
		{
			// 完整源码查看器：任何示例卡都能跳到这里看当前页全文
			"path": "pages/source/index",
			"style": {
				"navigationBarTitleText": "完整源码",
				"backgroundColor": "#f4f7fb"
			}
		}
	],
	// 分包：工程化 / 性能专题页放进 pages-sub，演示真实 subPackages 结构
	"subPackages": [
		{
			"root": "pages-sub",
			"pages": [
				{
					"path": "engineering/index",
					"style": {
						"navigationBarTitleText": "工程化与分包"
					}
				}
			]
		}
	],
	// 原生 tabBar（不配图标时仅显示文字，跨端都可运行）
	"tabBar": {
		"color": "#909399",
		"selectedColor": "#01beff",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"fontSize": "26rpx",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页"
			},
			{
				"pagePath": "pages/components/index",
				"text": "组件"
			},
			{
				"pagePath": "pages/template/index",
				"text": "模板"
			},
			{
				"pagePath": "pages/theme/index",
				"text": "主题"
			},
			{
				"pagePath": "pages/mine/index",
				"text": "我的"
			}
		]
	},
	// 全局样式
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "TuniaoUI",
		"navigationBarBackgroundColor": "#ffffff",
		"backgroundColor": "#f5f6fa",
		"backgroundColorTop": "#f5f6fa",
		"backgroundColorBottom": "#f5f6fa"
	}
}
