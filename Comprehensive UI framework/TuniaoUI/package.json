{
  "name": "tuniaoui",
  "version": "1.0.0",
  "description": "TuniaoUI framework - 全知识点示例工程",
  "license": "ISC",
  "author": "LiuQi",
  "scripts": {
    "postinstall": "node scripts/patch-tuniao-popup.mjs",
    "gen:sources": "node scripts/generate-page-sources.mjs && node scripts/generate-demo-codes.mjs",
    "dev:app": "npm run gen:sources && uni -p app",
    "dev:h5": "npm run gen:sources && uni",
    "dev:mp-weixin": "npm run gen:sources && uni -p mp-weixin",
    "build:h5": "npm run gen:sources && uni build",
    "build:app": "npm run gen:sources && uni build -p app",
    "build:mp-weixin": "npm run gen:sources && uni build -p mp-weixin && node scripts/ensure-mp-legacy-current-page.mjs",
    "type-check": "vue-tsc --noEmit",
    "type-check:src": "node scripts/check-src-types.mjs",
    "check": "npm run test && npm run type-check:src",
    "ci": "npm run check && npm run build:h5 && npm run build:mp-weixin",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-compiler": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-vue": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "@tuniao/tn-icon": "^1.11.0",
    "@tuniao/tn-style": "^1.0.20",
    "@tuniao/tnui-vue3-uniapp": "^1.0.23",
    "dayjs": "^1.11.23",
    "lz-string": "^1.5.0",
    "pinia": "^2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-app-plus": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-vite": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-vue": "3.0.0-4020920240930001",
    "@dcloudio/uni-cli-shared": "3.0.0-4020920240930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "@types/node": "^26.6.9",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.77.8",
    "sass-loader": "^17.1.1",
    "typescript": "^5.1.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-router": "4.3.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@dcloudio/uni-h5": {
      "vue-router": "4.3.2"
    },
    "@tuniao/tnui-vue3-uniapp": {
      "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
      "@dcloudio/uni-cli-shared": "3.0.0-4020920240930001",
      "@dcloudio/uni-app": "3.0.0-4020920240930001",
      "@dcloudio/uni-components": "3.0.0-4020920240930001",
      "@dcloudio/uni-h5": "3.0.0-4020920240930001",
      "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
      "@dcloudio/uni-mp-vue": "3.0.0-4020920240930001",
      "@dcloudio/uni-mp-compiler": "3.0.0-4020920240930001",
      "vue-i18n": "11.4.23"
    }
  }
}
