{
  "name": "base-tuniao-ui",
  "version": "1.0.0",
  "private": true,
  "description": "图鸟系统管理基础框架 · 单仓多应用",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:h5": "npm run dev:h5 -w @btn/admin",
    "build:h5": "npm run build:h5 -w @btn/admin",
    "dev:mp": "npm run dev:mp -w @btn/mp",
    "build:mp": "npm run build:mp -w @btn/mp",
    "type-check": "npm run type-check -w @btn/admin && npm run type-check -w @btn/mp",
    "lint": "npm run lint -w @btn/admin",
    "lint:fix": "npm run lint:fix -w @btn/admin",
    "test": "npm run test -w @btn/admin",
    "test:watch": "npm run test:watch -w @btn/admin",
    "test:e2e": "npm run test:e2e -w @btn/admin",
    "test:e2e:report": "npm run test:e2e:report -w @btn/admin",
    "format": "npm run format -w @btn/admin",
    "format:check": "npm run format:check -w @btn/admin",
    "verify": "npm run verify -w @btn/admin"
  },
  "overrides": {
    "@dcloudio/uni-h5": {
      "vue-router": "4.3.2"
    },
    "@tuniao/tnui-vue3-uniapp": {
      "typescript": "^5.1.6",
      "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
      "@dcloudio/uni-cli-shared": "3.0.0-4020920240930001",
      "@dcloudio/uni-app": "3.0.0-4020920240930001",
      "@dcloudio/uni-components": "3.0.0-4020920240930001",
      "@dcloudio/uni-h5": "3.0.0-4020920240930001"
    }
  }
}
