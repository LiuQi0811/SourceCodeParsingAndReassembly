{
	// easycom：自动引入图鸟组件，规则与官方保持一致
	"easycom": {
		"autoscan": true,
		"custom": {
			"^tn-(.*)": "@tuniao/tnui-vue3-uniapp/components/$1/src/$1.vue"
		}
	},

	// 页面：登录 → 工作台 → 系统管理各模块
	"pages": [
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/home/index",
			"style": {
				"navigationBarTitleText": "工作台"
			}
		},
		{
			"path": "pages/system/user/index",
			"style": {
				"navigationBarTitleText": "用户管理"
			}
		},
		{
			"path": "pages/system/role/index",
			"style": {
				"navigationBarTitleText": "角色权限"
			}
		},
		{
			"path": "pages/system/menu/index",
			"style": {
				"navigationBarTitleText": "菜单管理"
			}
		},
		{
			"path": "pages/system/dept/index",
			"style": {
				"navigationBarTitleText": "部门管理"
			}
		},
		{
			"path": "pages/system/dict/index",
			"style": {
				"navigationBarTitleText": "字典管理"
			}
		},
		{
			"path": "pages/system/log/index",
			"style": {
				"navigationBarTitleText": "操作日志"
			}
		},
		{
			"path": "pages/operation/deco/index",
			"style": {
				"navigationBarTitleText": "页面装修"
			}
		}
	],

	// 全局样式：统一使用自定义导航栏，由 AppLayout 自绘顶栏
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "图鸟系统管理",
		"navigationBarBackgroundColor": "#ffffff",
		"backgroundColor": "#f4f6fa"
	}
}
