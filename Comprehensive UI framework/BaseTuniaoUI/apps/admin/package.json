{
  "name": "@btn/admin",
  "version": "1.0.0",
  "description": "图鸟系统管理基础框架 · 后台端（H5）",
  "license": "ISC",
  "author": "LiuQi",
  "scripts": {
    "dev:app": "uni -p app",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\" \"e2e/**/*.ts\" \"*.ts\"",
    "verify": "npm run lint && npm run type-check && npm run format:check && npm test && npm run build:h5"
  },
  "dependencies": {
    "@btn/deco": "1.0.0",
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@tuniao/tn-icon": "^1.11.0",
    "@tuniao/tn-style": "^1.0.20",
    "@tuniao/tnui-vue3-uniapp": "^1.0.23",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-cli-shared": "3.0.0-4020920240930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.10.1",
    "sass": "^1.77.8",
    "sass-loader": "^17.1.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-router": "4.3.2",
    "vue-tsc": "^3.3.14"
  }
}
