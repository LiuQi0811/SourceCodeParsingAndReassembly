   "source": [
    "from langchain.chat_models import init_chat_model\n",
    "\n",
    "model = init_chat_model(\n",
    "    model_provider='openai',\n",
    "    base_url='http://localhost:11434/v1',\n",
    "    api_key='dummy',\n",
    "    model='glm4:9b',\n",
    "    temperature=0\n",
    ")\n",
    "response = model.invoke('给我来首古诗 静夜思')\n",
    "print(response.content)\n"
   ],
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "床前明月光，\n",
      "疑是地上霜。\n",
      "举头望明月，\n",
      "低头思故乡。\n"
     ]
    }
   ],
