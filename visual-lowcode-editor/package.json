{
  "name": "visual-lowcode-editor",
  "version": "1.0.0",
  "description": "纯 TypeScript + CSS3 + HTML 的网页低代码编辑器 MVP",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort --port ${DEPLOY_RUN_PORT:-5000}",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --strictPort --port ${DEPLOY_RUN_PORT:-5000}",
    "ts-check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test src/core/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
