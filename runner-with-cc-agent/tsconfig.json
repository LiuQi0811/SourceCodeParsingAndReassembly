// tsconfig.json - TypeScript 编译配置文件（Bun 项目）
{
  "compilerOptions": {
    // 编译后目标JS版本：ESNext 代表使用最新原生JS特性，不做降级转译（Bun运行时原生支持）
    "target": "ESNext",
    // 模块系统：ESNext 使用 ES Module (import/export)，而非 CommonJS
    "module": "ESNext",
    // 模块解析策略：bundler，适配打包器（Vite/Bun打包）的解析规则，支持裸模块导入
    "moduleResolution": "bundler",
    // 允许项目中混合使用 JS 文件，不强制全部 ts
    "allowJs": true,
    // 关闭对JS文件的类型检查（JS文件不会做类型校验，提升编译速度）
    "checkJs": false,
    // JSX编译模式：react-jsx，新版React自动导入jsx-runtime，无需手动import React
    "jsx": "react-jsx",
    // 允许默认导入兼容：支持 import xxx from 'cjs-pkg' 导入CommonJS包
    "allowSyntheticDefaultImports": true,
    // ES模块互操作：兼容CommonJS与ESModule之间的导入导出
    "esModuleInterop": true,
    // 允许直接导入 json 文件（如前面代码里 import pkg from '../package.json' 需要此项）
    "resolveJsonModule": true,
    // 跳过第三方库类型定义(.d.ts)的类型检查，加快编译，规避部分类型库报错
    "skipLibCheck": true,
    // 关闭严格类型模式：不强制开启类型校验（可减少类型报错，生产建议改为true）
    "strict": false,
    // 模块路径解析基准目录，paths 路径别名以此为根，当前为项目根目录
    "baseUrl": ".",
    // 路径别名配置，简化导入写法
    "paths": {
      // import xxx from "src/xxx" 等价于 import xxx from "./src/xxx"
      "src/*": [
        "./src/*"
      ]
    },
    // 全局类型声明：引入 bun 的内置类型定义
    "types": [
      "bun"
    ]
  },
  // 编译器需要包含的源码目录，tsc会扫描这些目录下文件做类型处理
  "include": [
    "src/**/*", // src目录下所有文件
    "vendor/**/*", // vendor第三方本地源码
    "shims/**/*" // shims 环境补丁/全局声明文件
  ]
}
