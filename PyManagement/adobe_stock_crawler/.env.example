# Adobe Stock 爬虫配置文件
# 复制此文件为 .env 并填入你的配置

# ============================================================
# 请求配置
# ============================================================

# 是否使用 Selenium 浏览器模式（可以更好地绕过 Cloudflare，但较慢）
# 默认 false，遇到 403 时改为 true
USE_SELENIUM=false

# Selenium 是否使用无头模式
HEADLESS=true

# ChromeDriver 路径（留空自动检测）
CHROME_DRIVER_PATH=

# ============================================================
# 代理配置（可选，用于分散IP）
# ============================================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
